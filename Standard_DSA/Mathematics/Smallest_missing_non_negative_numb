class Solution {
public:
    int findSmallestInteger(vector<int>& nums, int value)
     {     int n=nums.size();
           int sz=max(n,value)+1;
           vector<int>vis(sz,0);

           for(auto vl:nums)
           {
              int r=(vl%value+value)%value;
              //cout<<r<<endl;

              while(r<sz)
              {

                 if(vis[r]==0)
                 {
                    vis[r]=1;
                    break;
                 }
                 r=r+value;
              }

           }

           for(int i=0;i<sz;i++)
           {
              if(vis[i]==0)
              return i;
           }

           return sz;
     }
};

//////////////////////////////
class Solution {
public:
    int findSmallestInteger(vector<int>& nums, int v)
     {

        int m[100001]={},sz=nums.size();

        for(auto n:nums)
        {
            ++m[(v+n%v)%v];
        }

        for(int i=0;i<sz;++i)
        {

            if(--m[i%v]<0)
            return i;

        }

        return sz;

     }
};