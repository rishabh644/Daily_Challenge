with TB1 as (select distinct managerId from Employee),
TB2 as (select TB1.managerId as mId ,count(Employee.id) from TB1,Employee where TB1.managerId=Employee.managerId group by TB1.managerId having count(Employee.id)>=5)

select Employee.name from Employee,TB2 where Employee.id=TB2.mId


